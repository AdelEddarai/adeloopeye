# ─── App ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8100/api/news
NEXT_PUBLIC_CHAT_API_URL=http://localhost:8100/api/chat
NEXT_PUBLIC_CONFLICT_ID="iran-2026"

# ─── Supabase ───────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_xxx"
SUPABASE_SERVICE_ROLE_KEY="sb_service_role_xxx"

# ─── OpenAI — embeddings and LLM analysis ───────────────────────
OPENAI_API_KEY="sk-xxx"

# ─── X AI (Grok) — tweet verification and X post discovery ─────
XAI_API_KEY="xai-xxx"
XAI_MODEL="grok-4-1-fast-reasoning"

# ─── YouTube Data API v3 — live stream detection for Perspectives ─
# Get a free key at https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3" under APIs & Services > Library
YOUTUBE_API_KEY="AIza..."

# ─── NewsAPI — Real-time news for events, signals, and heat map ───
# Multiple news sources with automatic fallback for better reliability
# 
# Option 1: GNews API (RECOMMENDED - 15,000 requests/month free)
# Get a free key at https://gnews.io/register
GNEWS_API_KEY="your_gnews_key_here"

# Option 2: NewsData.io (200 requests/day free)
# Get a free key at https://newsdata.io/register
NEWSDATA_API_KEY="your_newsdata_key_here"

# Option 3: NewsAPI.org (100 requests/day free - used as fallback)
# Get a free key at https://newsapi.org/register
NEWSAPI_KEY="your_newsapi_key_here"

# ─── API-Ninjas — Free commodity prices (Oil, Gas, Gold, Silver, Copper) ─
# Get a free key at https://api-ninjas.com/register
# Free tier: 50,000 requests/month
API_NINJAS_KEY="your_api_ninjas_key_here"

# ─── Morocco Intelligence APIs (All FREE!) ─────────────────────

# Open-Meteo Weather API (FREE - No API key needed!)
# Provides real-time weather for 8 Moroccan cities
# https://open-meteo.com/en/docs
# No configuration needed - works out of the box!

# NASA FIRMS Fire Detection API (FREE with registration)
# Real-time wildfire detection from satellite data
# Get a free key at https://firms.modaps.eosdis.nasa.gov/api/
# Free tier: Unlimited requests
NASA_FIRMS_API_KEY="your_nasa_firms_key_here"

# Telegram Bot API (FREE - No limits on public channel monitoring)
# Real-time OSINT from Telegram public channels
# Get a bot token from @BotFather on Telegram:
#   1. Open Telegram and search for @BotFather
#   2. Send /newbot and follow instructions
#   3. Copy the bot token
#   4. Add bot to channels you want to monitor (as admin with read permissions)
# Format: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_TOKEN=""

# ─── Google Analytics ──────────────────────────────────────────
# Get your Measurement ID (GA4) from https://analytics.google.com/
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# ─── PostHog analytics ─────────────────────────────────────────
NEXT_PUBLIC_ANALYTICS_ENABLED="false"
NEXT_PUBLIC_POSTHOG_KEY="phc_xxx"
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
